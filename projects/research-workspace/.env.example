# Trusted import process only. Never include these in browser assets.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# API and worker. Use a dedicated service database role in production.
RESEARCH_DATABASE_URL=
RESEARCH_ALLOWED_ORIGINS=https://haroldng.dev,http://localhost:4321
RESEARCH_SUPABASE_URL=
RESEARCH_SUPABASE_KEY=
RESEARCH_STORAGE_BUCKET=research-artifacts
RESEARCH_SESSION_SECRET=
RESEARCH_POOL_SIZE=8
RESEARCH_MAX_QUEUED=100
RESEARCH_MAX_ACTIVE_SESSION=3
RESEARCH_MAX_REQUESTS_SESSION=12
RESEARCH_MAX_REQUESTS_NETWORK=30
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_MAX_SECONDS=120
RESEARCH_MAX_RESULTS=1000000
RESEARCH_RESULT_RETENTION_DAYS=30
RESEARCH_MAX_ATTEMPTS=3
# Private operator storage; never exposed through the API.
RESEARCH_ARTIFACT_ROOT=
# Admission checks the database volume before accepting new search work.
# Leave the path empty only for development without capacity monitoring.
RESEARCH_CAPACITY_PATH=
RESEARCH_MIN_FREE_BYTES=1073741824

# Portfolio build only; this is public and contains no credential.
PUBLIC_RESEARCH_API_URL=

# Collector fixture location for data/verify_postgres.py.
RESEARCH_SOURCE_PROJECT=

# Optional isolated verification databases; never point growth/restore at production.
RESEARCH_TEST_DATABASE_URL=
RESEARCH_GROWTH_DATABASE_URL=
RESEARCH_RESTORE_DATABASE_URL=
RESEARCH_MAINTENANCE_URL=
