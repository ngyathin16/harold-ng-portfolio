---
import '@fontsource-variable/dm-sans';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import sansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import italicFont from '@fontsource/newsreader/files/newsreader-latin-400-italic.woff2?url';
import '../styles/global.css';
import '../styles/components.css';
import TubelightNav from '../components/TubelightNav';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Harold Ng — AI Solutions Engineer in Hong Kong',
  description = 'Harold Ng, AI Solutions Engineer in Hong Kong. Practical AI tools, thoughtful software, and the evidence behind the work. Explore QueryProof, ReleaseGuard and more.',
  noindex = false,
} = Astro.props;
const isPublic = Boolean(import.meta.env.SITE_URL);
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/images/social-preview.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f1" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !isPublic ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harold Ng" />
    <meta property="og:locale" content="en_HK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Harold Ng — AI Solutions Engineer based in Hong Kong" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="wordmark" aria-label="Harold Ng, home">h<span aria-hidden="true">n.</span></a>
        <TubelightNav pathname={Astro.url.pathname} client:load />
        <a class="header-contact" href="mailto:haroldng2001@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <a class="footer-name" href="/">&copy; 2026 Harold Ng</a>
      <p>Built with care. Based in Hong Kong.</p>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
