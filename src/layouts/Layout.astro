---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Harold Ng — AI engineer in Hong Kong',
  description = 'AI engineer based in Hong Kong. Selected work in AI tools, building models, and the software that makes them useful.',
  noindex = false,
} = Astro.props;
const isPublic = Boolean(import.meta.env.SITE_URL);
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/images/social-preview.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ed" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !isPublic ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harold Ng" />
    <meta property="og:locale" content="en_HK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Harold Ng — AI engineer based in Hong Kong" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a href="/" class="wordmark" aria-label="Harold Ng, home">hn<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
        <a href="/resume.pdf" class="nav-resume" download>Résumé <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <a class="footer-name" href="/">Harold Ng</a>
      <p>Hong Kong <span aria-hidden="true">↔</span> California</p>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
