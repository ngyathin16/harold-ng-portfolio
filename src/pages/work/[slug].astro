---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projectIndex = projects.findIndex((entry) => entry.id === project.id);
const related = projects.length > 1 ? projects[(projectIndex + 1) % projects.length] : undefined;
---
<Layout title={`${data.title} — Harold Ng`} description={data.summary}>
  <article class={`case-study case-${data.slug}`}>
    <header class="case-header shell">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> Selected work</a>
      <div class="case-kicker eyebrow">{data.workType}<span aria-hidden="true">/</span>{data.period}</div>
      <h1>{data.title}</h1>
      <p class="case-summary">{data.summary}</p>
      <dl class="case-facts">
        <div><dt>My contribution</dt><dd>{data.contribution}</dd></div>
        <div><dt>Status</dt><dd>{data.status}</dd></div>
        <div><dt>Built with</dt><dd>{data.technologies.join(' · ')}</dd></div>
      </dl>
      <div class="case-actions">
        {data.repository && <a class="button" href={data.repository}>View source on GitHub <span aria-hidden="true">↗</span></a>}
        {data.sourceDownload && <a class="button" href={data.sourceDownload} download>Download runnable source <span class="file-label">ZIP</span> <span aria-hidden="true">↓</span></a>}
        {data.demo && <a class="text-link" href={data.demo}>Open demo <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    <figure class="case-cover shell">
      <a href={data.cover} aria-label={`Open full screenshot of ${data.title}`}><img src={data.cover} alt={data.coverAlt} width={data.coverWidth} height={data.coverHeight} fetchpriority="high" /></a>
      <figcaption>{data.coverCaption}</figcaption>
    </figure>
    <div class="case-body shell">
      <aside class="case-sidebar"><nav aria-label="On this page"><p class="eyebrow">In this project</p>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <section class="case-next shell" aria-label="More work">
    <p class="eyebrow">Keep exploring</p>
    {related && <a href={`/work/${related.data.slug}/`}>{related.data.title}<span aria-hidden="true">↗</span></a>}
    <a class="text-link" href="mailto:haroldng2001@gmail.com">Talk to me about the work <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
